{
  "name": "dsh-oh-my-claude",
  "version": "1.3.1",
  "type": "module",
  "description": "Claude Code CLI as an LLM provider for dsh (DeepSeek Harness): live model list, per-session resume, approval relay, images, a memory/rewind/changes panel, and workspaces on remote SSH boxes",
  "keywords": [
    "dsh",
    "deepseek",
    "claude",
    "claude-code",
    "anthropic",
    "llm",
    "llm-provider",
    "ai-agent",
    "coding-agent",
    "plugin",
    "stream-json",
    "cli",
    "typescript",
    "bun"
  ],
  "main": "lib/server/adapter.js",
  "exports": {
    ".": {
      "types": "./lib/server/adapter.d.ts",
      "default": "./lib/server/adapter.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "ls src/*.test.ts src/client/*.test.ts | xargs -P 8 -I{} sh -c 'DSH_OMC_STATE_DIR=$(mktemp -d /tmp/omc-test.XXXXXX) bun \"$1\"' _ {}",
    "lint": "oxlint src/ tools/ --max-warnings=0",
    "format": "oxfmt src/ tools/",
    "deadcode": "fallow dead-code",
    "build:server": "rm -rf lib/server && tsc -p tsconfig.build.json",
    "build:client": "NODE_ENV=production bun build src/client/index.tsx --format=cjs --target=browser --minify --outfile=lib/client.js --external react --external react/jsx-runtime --external react-dom --external '@deepseek-ai/*' --banner='window.__ModuleLoader__.load({ id: \"dsh-oh-my-claude\", factory: (require) => { var module = { exports: {} }; var exports = module.exports;' --footer='return module.exports; } });'",
    "build": "bun run build:server && bun run build:client",
    "prepare": "bun run build",
    "validate": "bun tools/validate.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.1",
    "@oxlint/plugins": "1.80.0",
    "@types/node": "^26.4.1",
    "@types/react": "18",
    "fallow": "^3.17.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.80.0",
    "react": "18",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "lib",
    "README.md",
    "CHANGELOG.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "homepage": "https://github.com/lcestou/dsh-oh-my-claude#readme",
  "bugs": {
    "url": "https://github.com/lcestou/dsh-oh-my-claude/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcestou/dsh-oh-my-claude.git"
  },
  "license": "MIT",
  "types": "lib/server/adapter.d.ts"
}
