{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "jsPlugins": [
    "./tools/oxlint/anti-slop/index.ts"
  ],
  "rules": {
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop/no-object-parameters": "off",
    "jsx-a11y/control-has-associated-label": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/prefer-tag-over-role": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "anti-slop/require-field-label": "error",
    "anti-slop/require-doc-comment": "error"
  },
  "overrides": [
    {
      "files": [
        "src/**/*.test.ts"
      ],
      "rules": {
        "anti-slop/require-safety-comment-for-type-assertion": "off",
        "anti-slop/require-doc-comment": "off",
        "anti-slop/no-chained-type-assertions": "off",
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-known-value-widening": "off",
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-runtime-typeof": "off",
        "eslint/no-shadow": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      "files": [
        "src/permissions.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    {
      "files": [
        "src/anthropic-status.ts",
        "src/process.ts",
        "src/stars.ts",
        "src/remote-fs.ts",
        "src/hold.ts",
        "src/reach.ts",
        "src/keeper.ts",
        "src/transcript.ts",
        "src/search.ts",
        "src/mcp.ts",
        "src/mcp-add-remove.ts",
        "src/plugins.ts",
        "src/report.ts",
        "src/sessions.ts",
        "src/scheduled-tasks.ts",
        "src/state.ts",
        "src/claude-update.ts",
        "src/usage.ts",
        "src/translator.ts",
        "src/client/shared.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    {
      "files": [
        "src/anthropic-status.ts",
        "src/process.ts",
        "src/remote-fs.ts",
        "src/hold.ts",
        "src/transcript.ts",
        "src/search.ts",
        "src/mcp.ts",
        "src/mcp-add-remove.ts",
        "src/plugins.ts",
        "src/report.ts",
        "src/sessions.ts",
        "src/scheduled-tasks.ts",
        "src/state.ts",
        "src/claude-update.ts",
        "src/usage.ts",
        "src/translator.ts"
      ],
      "rules": {
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      "files": [
        "src/sessions.ts",
        "src/usage.ts"
      ],
      "rules": {
        "anti-slop/no-unknown-returns": "off"
      }
    },
    {
      "files": [
        "src/anthropic-status.ts",
        "src/process.ts",
        "src/hold.ts",
        "src/reach.ts",
        "src/report.ts",
        "src/transcript.ts",
        "src/search.ts",
        "src/sessions.ts",
        "src/scheduled-tasks.ts",
        "src/state.ts",
        "src/claude-update.ts",
        "src/usage.ts",
        "src/translator.ts"
      ],
      "rules": {
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      "files": [
        "src/session-repair.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-known-value-widening": "off"
      }
    },
    {
      "files": [
        "src/test-dsh.ts"
      ],
      "rules": {
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-chained-type-assertions": "off",
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    {
      "files": [
        "tools/oxlint/anti-slop/shared/lexical-type-parameters.ts",
        "tools/oxlint/anti-slop/rules/no-runtime-typeof.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-chained-type-assertions": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
